# No se necesitan en la v0.1 (datos demo). Rellénalas al conectar los servicios reales.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (Anthropic): lectura de la web de la empresa al crear prospectos (/api/personas/from-web).
# Sin esta clave, la creación desde web funciona con reglas sencillas.
ANTHROPIC_API_KEY=

# ElevenLabs Agents: voz real del prospecto en el simulador (/api/voice/session).
# Sin esta clave, el simulador funciona en modo demo con la voz del navegador.
ELEVENLABS_API_KEY=
# Opcionales: id de un agente ya creado y voces fijas (si no, se crea el agente
# "Sparring IA · Prospecto" y se eligen voces con acento peruano de la biblioteca).
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_FEMALE=
# ELEVENLABS_VOICE_MALE=

# Pendiente (fase 2): proveedor de datos B2B para obtener decisores reales por dominio
# APOLLO_API_KEY=

# IA: análisis, transcripción y simulador de voz
OPENAI_API_KEY=
# Opcionales según el proveedor de transcripción elegido
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# Pagos (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
